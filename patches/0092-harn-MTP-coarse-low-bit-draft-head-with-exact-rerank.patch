 bool llama_prec_policy::apply(ggml_tensor * res) const {
@@ -3184,12 +3190,102 @@ static bool mtp_draft_vocab_ids_follow_merge_order(const llama_vocab & vocab, st
     return true;
 }
 
+// Coarse MTP draft head: the whole LM head requantized (on the CPU, once) to a low-bit type. See llama_mtp_draft_vocab.
+static std::shared_ptr<llama_mtp_draft_vocab> mtp_draft_coarse_build(const ggml_tensor * out, ggml_backend_buffer_type_t buft, int32_t rerank) {
+    ggml_type type = GGML_TYPE_Q2_K;
+    if (const char * t = getenv("LLAMA_MTP_DRAFT_COARSE_TYPE")) {
+        bool found = false;
+        for (int i = 0; i < GGML_TYPE_COUNT; ++i) {
+            const char * name = ggml_type_name((ggml_type) i);
+            if (name && strcmp(name, t) == 0) { type = (ggml_type) i; found = true; break; }
+        }
+        if (!found) {
+            LLAMA_LOG_ERROR("%s: unknown LLAMA_MTP_DRAFT_COARSE_TYPE %s\n", __func__, t);
+            return nullptr;
+        }
+    }
+    const auto * src_traits = ggml_get_type_traits(out->type);
+    if (out->ne[0] % ggml_blck_size(type) != 0 || (out->type != GGML_TYPE_F32 && src_traits->to_float == nullptr)) {
+        LLAMA_LOG_ERROR("%s: cannot requantize %s to %s\n", __func__, ggml_type_name(out->type), ggml_type_name(type));
+        return nullptr;
+    }
+    const int64_t n_embd = out->ne[0];
+    const int64_t n_row  = out->ne[1];
+    const size_t  src_row = out->nb[1];
+    const size_t  dst_row = ggml_row_size(type, n_embd);
+    const int64_t t0 = ggml_time_us();
+
+    std::vector<uint8_t> src((size_t) n_row * src_row);
+    ggml_backend_tensor_get(out, src.data(), 0, src.size());
+    std::vector<uint8_t> dst((size_t) n_row * dst_row);
+
+    const int n_threads = std::max(1u, std::min(32u, std::thread::hardware_concurrency()));
+    std::vector<std::thread> workers;
+    for (int w = 0; w < n_threads; ++w) {
+        workers.emplace_back([&, w]() {
+            std::vector<float> f((size_t) 64 * n_embd);
+            for (int64_t r0 = (int64_t) w * 64; r0 < n_row; r0 += (int64_t) n_threads * 64) {
+                const int64_t nr = std::min<int64_t>(64, n_row - r0);
+                if (out->type == GGML_TYPE_F32) {
+                    memcpy(f.data(), src.data() + r0 * src_row, nr * src_row);
+                } else {
+                    src_traits->to_float(src.data() + r0 * src_row, f.data(), nr * n_embd);
+                }
+                ggml_quantize_chunk(type, f.data(), dst.data() + r0 * dst_row, 0, nr, n_embd, nullptr);
+            }
+        });
+    }
+    for (auto & t : workers) {
+        t.join();
+    }
+
+    auto res = std::make_shared<llama_mtp_draft_vocab>();
+    res->src    = out;
+    res->rerank = rerank;
+    ggml_init_params ip = { 1 * ggml_tensor_overhead(), nullptr, true };
+    res->ctx.reset(ggml_init(ip));
+    res->head = ggml_new_tensor_2d(res->ctx.get(), type, n_embd, n_row);
+    ggml_format_name(res->head, "mtp_draft_coarse_head");
+    res->buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(res->ctx.get(), buft));
+    if (!res->buf) {
+        LLAMA_LOG_ERROR("%s: buffer allocation failed\n", __func__);
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(res->buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_tensor_set(res->head, dst.data(), 0, dst.size());
+    LLAMA_LOG_INFO("%s: MTP draft head: coarse %s copy of the %s LM head (%.2f MiB), rerank top %d exactly (%.1f s)\n", __func__,
+                   ggml_type_name(type), ggml_type_name(out->type), (double) dst.size() / 1048576.0, rerank,
+                   (ggml_time_us() - t0) / 1e6);
+    return res;
+}
+
+std::shared_ptr<const llama_mtp_draft_vocab> llama_model::draft_coarse_head() const {
+    const char * e = getenv("LLAMA_MTP_DRAFT_COARSE");
+    if (e == nullptr || atoi(e) <= 0 || output == nullptr || output->buffer == nullptr || output->data == nullptr ||
+            output_s != nullptr) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(pimpl->coarse_mutex);
+    if (!pimpl->coarse_tried) {
+        pimpl->coarse_tried = true;
+        auto res = mtp_draft_coarse_build(output, ggml_backend_buffer_get_type(output->buffer), atoi(e));
+        if (res) {
+            res->n_keep = 1;
+        }
+        pimpl->coarse = res;
+    }
+    return pimpl->coarse;
+}
+
 std::shared_ptr<const llama_mtp_draft_vocab> llama_model::mtp_draft_vocab_get(int32_t n_keep, bool shared_target_head) const {
     const ggml_tensor * out = output;
     // probe contexts (common_fit_params) use a model with unallocated weights: no subset
     if (n_keep <= 0 || out == nullptr || out->buffer == nullptr || out->data == nullptr) {
         return nullptr;
     }
+    if (auto coarse = draft_coarse_head()) {
+        return coarse;
+    }
     // only the MTP graphs that were taught the subset use it, and only when they score with the model LM head:
     // qwen35/qwen35moe/qwen4exp (their nextn block or the borrowed target head), and gemma4-assistant, whose
     // `output` is its own tied token embedding
@@ -3227,6 +3323,7 @@ std::shared_ptr<const llama_mtp_draft_vocab> llama_model::mtp_draft_vocab_get(in
         return it->second.lock();
     }
 
+
     std::string why;
     if (!mtp_draft_vocab_ids_follow_merge_order(vocab, why)) {
         LLAMA_LOG_ERROR("%s: mtp_draft_vocab = %d ignored: %s\n", __func__, n_keep, why.c_str());
diff --git a/src/llama-model.h b/src/llama-model.h
index dc6b8b4..14528b1 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -780,6 +780,12 @@ struct llama_mtp_draft_vocab {
     ggml_tensor * head = nullptr; // [n_embd, n_rows], same type as the LM head
     ggml_tensor * ids  = nullptr; // [n_rows] I64, token id of each row
 
+    // coarse mode (env LLAMA_MTP_DRAFT_COARSE=K): `head` is the WHOLE LM head requantized to a low-bit type
+    // (LLAMA_MTP_DRAFT_COARSE_TYPE, default q2_K), `ids` is unused. The graph scores every token with it, takes
+    // the K best and rescores those K rows exactly against the original head (the rest keep their coarse
+    // logits). Only the draft proposal changes; the target verifies with its own untouched head.
+    int32_t rerank = 0;
+
     ggml_context_ptr        ctx;
     ggml_backend_buffer_ptr buf;
 };
@@ -1050,6 +1056,8 @@ struct llama_model {
     // shared_target_head = true: this model is the target of a shared-NextN sidecar whose MTP graph borrows this
     // output as its LM head - the consumer is that sidecar's graph, so the model's own MTP-block checks are skipped
     std::shared_ptr<const llama_mtp_draft_vocab> mtp_draft_vocab_get(int32_t n_keep, bool shared_target_head = false) const;
+    // coarse low-bit copy of the whole LM head for drafters (env LLAMA_MTP_DRAFT_COARSE=K), nullptr when off
+    std::shared_ptr<const llama_mtp_draft_vocab> draft_coarse_head() const;
 
     float get_rope_freq_base (const llama_cparams & cparams, int il) const;
     float get_rope_freq_scale(const llama_cparams & cparams, int il) const;
diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
index 067f126..087637e 100644
--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -664,6 +664,20 @@ llama_model_qwen35::graph_mtp::graph_mtp(const llm_graph_params & params)
     GGML_ASSERT(head_w && "QWEN35 MTP: missing LM head (nextn.shared_head_head or model.output)");
     if (mtp_draft != nullptr && head_w == model.output && n_outputs == 1) {
         // this context drafts over a row subset of the LM head: scatter its logits into a full-vocab row of -inf
+        if (mtp_draft->rerank > 0 && head_s == nullptr) {
+            // coarse head over the whole vocabulary, then the best `rerank` tokens rescored exactly
+            ggml_tensor * coarse = build_lora_mm(mtp_draft->head, cur, nullptr);          // [n_vocab, 1]
+            cb(coarse, "mtp_coarse_logits", -1);
+            ggml_tensor * best  = ggml_top_k(ctx0, coarse, mtp_draft->rerank);            // [K, 1] I32
+            ggml_tensor * rows  = ggml_get_rows(ctx0, model.output, best);                // [n_embd, K] F32
+            ggml_tensor * exact = ggml_mul_mat(ctx0, rows, cur);                          // [K, 1]
+            const int64_t n_row = coarse->ne[0];
+            cur = ggml_set_rows(ctx0, ggml_reshape_2d(ctx0, coarse, 1, n_row), ggml_reshape_2d(ctx0, exact, 1, mtp_draft->rerank), best);
+            cur = ggml_reshape_2d(ctx0, cur, n_row, 1);
+            cb(cur, "result_output", -1);
+            res->t_logits = cur;
+            return;
+        }
         GGML_ASSERT(mtp_draft->n_keep == cparams.mtp_draft_vocab);
         const int64_t n_sel = mtp_draft->head->ne[1];
         const int64_t n_row = model.output->ne[1];
